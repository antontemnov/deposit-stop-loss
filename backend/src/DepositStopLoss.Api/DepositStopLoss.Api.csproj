<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory), global.json))\.props\DotNetApp.targets" />

  <ItemGroup>
    <PackageReference Include="NetEscapades.Configuration.Yaml" />
    <PackageReference Include="FastEndpoints" />
    <PackageReference Include="FastEndpoints.Swagger" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="NodaTime.Serialization.SystemTextJson" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(Root)settings.yaml" Link="settings.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(Root)environments.yaml" Link="environments.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(Root)schedulers.yaml" Link="schedulers.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(Root)secrets.yaml" Link="secrets.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DepositStopLoss.Application\DepositStopLoss.Application.csproj" />
    <ProjectReference Include="..\DepositStopLoss.Infrastructure\DepositStopLoss.Infrastructure.csproj" />
  </ItemGroup>

</Project>
